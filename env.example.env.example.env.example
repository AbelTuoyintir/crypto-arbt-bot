# Base Token Configuration
BASE_TOKEN_NAME=Global Access Tech
BASE_TOKEN_SYMBOL=GAT
BASE_TOKEN_ADDRESS=0x1111111111111111111111111111111111111111
CHAIN_ID=56
RPC_URL=https://bsc-dataseed.binance.org/

# Wallet & Private Keys (NEVER store real private keys in committed source files)
# PRIVATE_KEY=0x...
# KEYSTORE_PATH=path/to/keystore.json

# Database
